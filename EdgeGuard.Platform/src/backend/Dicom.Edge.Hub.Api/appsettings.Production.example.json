{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Dicom.Edge.Hub.Infrastructure.Services.Hl7TcpListener": "Information",
      "Dicom.Edge.Hub.Application.Hl7.Hl7MessageProcessor": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HubDatabase": "Host=<host>;Port=5432;Database=<database>;Username=<username>;Password=<password>;Ssl Mode=Require;Trust Server Certificate=false"
  },
  "Hl7Listener": {
    "Enabled": true,
    "Port": 2575,
    "MaxConcurrentConnections": 200,
    "MaxQueuedMessages": 5000,
    "ProcessingWorkers": 8,
    "ConnectionTimeoutMs": 600000,
    "BufferSize": 16384
  },
  "HubBackgroundJobs": {
    "EnableNodeHealthEvaluator": true,
    "NodeHealthEvaluationIntervalSeconds": 30,
    "EnableStudyCleanupEvaluator": true,
    "StudyCleanupEvaluationIntervalSeconds": 180
  }
}
