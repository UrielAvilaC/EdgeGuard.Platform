{
  "Diagnostics": {
    "InstanceId": "HUB-001",
    "Application": "EdgeGuardHub",
    "Component": "Hub",
    "Environment": "Production",
    "MeterName": "Dicom.Edge.Hub",
    "ActivitySourceName": "Dicom.Edge.Hub",
    "CorrelationIdHeader": "X-Request-Id",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "hub-.log",
      "MaxFileSizeMb": 100,
      "RetainDays": 30,
      "RetainedFileCountLimit": 31,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKey": null
    },

    "HttpSink": {
      "Enabled": false,
      "Url": "",
      "BatchPostingLimit": 1000,
      "PeriodSeconds": 5
    },

    "OpenTelemetry": {
      "Enabled": false,
      "OtlpEndpoint": null,
      "ServiceName": "EdgeGuardHub",
      "ServiceVersion": "1.0.0",
      "Prometheus": {
        "Enabled": false,
        "Endpoint": "/metrics"
      }
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Strict",
      "ReplacementToken": "[REDACTED]",
      "RedactedProperties": [
        "PatientName",
        "PatientID",
        "PatientBirthDate",
        "PatientSex",
        "PatientAddress",
        "PatientTelephoneNumbers",
        "OtherPatientIDs",
        "OtherPatientNames",
        "ReferringPhysicianName",
        "InstitutionName",
        "InstitutionAddress"
      ],
      "RedactionPatterns": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "\\b\\d{10,15}\\b"
      ]
    },

    "HealthChecks": {
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 10000,
      "ConnectivityTimeoutSeconds": 10
    }
  },
  "AllowedHosts": "*",
  "Hl7Listener": {
    "Enabled": true,
    "Port": 8001
  },
  "MessageQueue": {
    "DispatchEnabled": true,
    "DispatchBatchSize": 20,
    "DispatchIntervalSeconds": 5,
    "MaxRetries": 5,
    "RetryDelaySeconds": 30,
    "DispatchTimeoutSeconds": 30,
    "MaxPendingMessages": 10000,
    "RetentionDays": 30
  },
  "HubBackgroundJobs": {
    "EnableNodeHealthEvaluator": true,
    "NodeHealthEvaluationIntervalSeconds": 60,
    "EnableStudyCleanupEvaluator": true,
    "StudyCleanupEvaluationIntervalSeconds": 300
  }
}
