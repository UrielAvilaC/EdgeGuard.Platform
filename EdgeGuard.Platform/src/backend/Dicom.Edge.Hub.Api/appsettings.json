{
  "Diagnostics": {
    "InstanceId": "HUB-001",
    "Application": "EdgeGuardHub",
    "Component": "Hub",
    "Environment": "Production",
    "MeterName": "Dicom.Edge.Hub",
    "ActivitySourceName": "Dicom.Edge.Hub",
    "CorrelationIdHeader": "X-Request-Id",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "hub-.log",
      "MaxFileSizeMb": 100,
      "RetainDays": 30,
      "RetainedFileCountLimit": 31,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKey": null
    },

    "HttpSink": {
      "Enabled": false,
      "Url": "",
      "BatchPostingLimit": 1000,
      "PeriodSeconds": 5
    },

    "OpenTelemetry": {
      "Enabled": false,
      "OtlpEndpoint": null,
      "ServiceName": "EdgeGuardHub",
      "ServiceVersion": "1.0.0",
      "Prometheus": {
        "Enabled": false,
        "Endpoint": "/metrics"
      }
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Strict",
      "ReplacementToken": "[REDACTED]",
      "RedactedProperties": [
        "PatientName",
        "PatientID",
        "PatientBirthDate",
        "PatientSex",
        "PatientAddress",
        "PatientTelephoneNumbers",
        "OtherPatientIDs",
        "OtherPatientNames",
        "ReferringPhysicianName",
        "InstitutionName",
        "InstitutionAddress"
      ],
      "RedactionPatterns": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "\\b\\d{10,15}\\b"
      ]
    },

    "HealthChecks": {
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 10000,
      "ConnectivityTimeoutSeconds": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:5173" ]
  },
  "Twilio": {
    "AccountSid": "REPLACE_WITH_TWILIO_ACCOUNT_SID",
    "AuthToken": "REPLACE_WITH_TWILIO_AUTH_TOKEN",
    "WhatsApp": {
      "From": "whatsapp:+14155238886",
      "MessagingServiceSid": "REPLACE_WITH_MESSAGING_SERVICE_SID",
      "Enabled": false,
      "SandboxMode": true
    }
  },
  "AllowedHosts": "*",
  "Hl7Listener": {
    "Enabled": true,
    "Port": 8001
  },
  "Hub": {
    "Workspace": {
      "ReportsPath": "workspace/reports",
      "MaxPdfMb": 25
    }
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "User": "REPLACE_WITH_SMTP_USER",
    "Password": "REPLACE_WITH_SMTP_PASSWORD",
    "From": "noreply@edgeguard.local",
    "FromName": "EdgeGuard",
    "UseTls": true
  },
  "Notifications": {
    "AutoMode": false
  },
  "Jwt": {
    "SecretKey": "DEV-ONLY-SuperSecretKey-AtLeast32Chars!",
    "Issuer": "EdgeGuard.Platform",
    "Audience": "EdgeGuard.Clients"
  }
}
 