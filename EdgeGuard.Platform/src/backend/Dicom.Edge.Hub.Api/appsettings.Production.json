{
  // ── JWT ─────────────────────────────────────────────────────────────────────
  // REQUIRED: override the DEV-ONLY placeholder before going live.
  // Set via env var:  Jwt__SecretKey=<your-256-bit-secret>
  // Or directly here (keep this file out of source control if using plain text).
  "Jwt": {
    "SecretKey": "REPLACE_WITH_PRODUCTION_SECRET_MIN_32_CHARS",
    "Issuer": "EdgeGuard.Platform",
    "Audience": "EdgeGuard.Clients"
  },

  // ── DataProtection ───────────────────────────────────────────────────────────
  // Point to a writable directory on the IIS server. The app-pool identity must
  // have Read/Write permissions on this path.
  // Without this, keys are ephemeral — SignalR and antiforgery tokens are
  // invalidated on every IIS app-pool recycle.
  "DataProtection": {
    "KeyPath": "C:\\inetpub\\edgeguard\\dp-keys"
  },

  // ── CORS ─────────────────────────────────────────────────────────────────────
  // Add every origin from which the Angular SPA will make API calls.
  // If the SPA is served from the SAME IIS site (same host:port), same-origin
  // requests do NOT need CORS — remove those entries or leave this list empty.
  // Add only origins that differ in scheme, host, or port from the API host.
  "Cors": {
    "AllowedOrigins": [
      "http://D-HUB",
      "https://D-HUB"
    ]
  },

  // ── Diagnostics ──────────────────────────────────────────────────────────────
  "Diagnostics": {
    "InstanceId": "HUB-001",
    "Environment": "Production"
  }
}
