{
  "Diagnostics": {
    "InstanceId": "HUB-DEV",
    "Application": "EdgeGuardHub",
    "Component": "Hub",
    "Environment": "Development",
    "MeterName": "Dicom.Edge.Hub",
    "ActivitySourceName": "Dicom.Edge.Hub",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "hub-.log",
      "UseCompactJson": false
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Relaxed"
    },

    "HealthChecks": {
      "StorageMinAvailableMb": 100,
      "ConnectivityTimeoutSeconds": 5
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Dicom.Edge.Hub.Infrastructure.Services.Hl7TcpListener": "Debug",
        "Dicom.Edge.Hub.Application.Hl7.Hl7MessageProcessor": "Debug",
        "Dicom.Edge.Hub.Infrastructure.HostedServices.MessageDispatchHostedService": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "HubDatabase": "Host=localhost;Port=5432;Database=edgeguard_hub;Username=postgres;Password=postgres"
  },
  "Hl7Listener": {
    "Enabled": true,
    "Port": 8001,
    "MaxConcurrentConnections": 100,
    "MaxQueuedMessages": 1000,
    "ProcessingWorkers": 4,
    "ConnectionTimeoutMs": 300000,
    "BufferSize": 8192
  },
  "MessageQueue": {
    "DispatchEnabled": true,
    "DispatchBatchSize": 20,
    "DispatchIntervalSeconds": 5,
    "MaxRetries": 5,
    "RetryDelaySeconds": 30,
    "DispatchTimeoutSeconds": 30,
    "MaxPendingMessages": 10000,
    "RetentionDays": 30
  },
  "HubBackgroundJobs": {
    "EnableNodeHealthEvaluator": true,
    "NodeHealthEvaluationIntervalSeconds": 60,
    "EnableStudyCleanupEvaluator": true,
    "StudyCleanupEvaluationIntervalSeconds": 300
  }
}
