{
  "Diagnostics": {
    "InstanceId": "HUB-DEV",
    "Application": "EdgeGuardHub",
    "Component": "Hub",
    "Environment": "Development",
    "MeterName": "Dicom.Edge.Hub",
    "ActivitySourceName": "Dicom.Edge.Hub",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "hub-.log",
      "UseCompactJson": false
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Relaxed"
    },

    "HealthChecks": {
      "StorageMinAvailableMb": 100,
      "ConnectivityTimeoutSeconds": 5
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Dicom.Edge.Hub.Infrastructure.Services.Hl7TcpListener": "Debug",
        "Dicom.Edge.Hub.Application.Hl7.Hl7MessageProcessor": "Debug",
        "Dicom.Edge.Hub.Infrastructure.HostedServices.MessageDispatchHostedService": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "HubDatabase": "Host=localhost;Database=edgeguard_db;Username=postgres;Password=postgres"
  },
  "Hl7Listener": {
    "Enabled": true,
    "Port": 8001
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:5173" ]
  },
  "Jwt": {
    "SecretKey": "DEV-ONLY-SuperSecretKey-AtLeast32Chars!"
  }
}
