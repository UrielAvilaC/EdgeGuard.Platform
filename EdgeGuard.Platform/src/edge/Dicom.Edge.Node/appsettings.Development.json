{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Dicom.Edge.Node": "Debug",
      "Dicom.Edge.Node.DicomServer": "Debug",
      "Dicom.Edge.Node.Configuration": "Debug",
      "Dicom.Edge.Node.Processing": "Debug",
      "Dicom.Edge.Node.Sender": "Debug"
    }
  },

  "ConnectionStrings": {
    "NodeDatabase": "Data Source=./persistence/edge-node-dev.db"
  },

  "Diagnostics": {
    "InstanceId": "NODE-DEV",
    "Application": "EdgeGuardNode",
    "Component": "Node",
    "Environment": "Development",
    "MeterName": "Dicom.Edge.Node",
    "ActivitySourceName": "Dicom.Edge.Node",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "node-.log",
      "UseCompactJson": false
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Relaxed"
    },

    "HealthChecks": {
      "StoragePath": "storage",
      "StorageMinAvailableMb": 100,
      "ConnectivityTimeoutSeconds": 5
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Dicom.Edge.Node.Configuration.HubConfigSyncHostedService": "Debug",
        "Dicom.Edge.Node.DicomServer.DicomServerHostedService": "Debug",
        "Dicom.Edge.Node.Processing.StudyProcessingHostedService": "Debug"
      }
    }
  },
  "NodeApi": {
    "Port": 5120
  },
  "HubConnection": {
    "Enabled": true,
    "HubBaseUrl": "https://localhost:7228",
    "NodeName": "RIS_SISTEMA",
    "IpAddress": "127.0.0.1",
    "Port": 11112,
    "Location": "RIS SISTEMA",
    "FacilityName": "RIS_SISTEMA",
    "Version": "1.0.0",
    "TimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "ConfigPullIntervalSeconds": 900,
    "RegisterOnStartup": true,
    "MaxReconnectAttempts": 10,
    "ReconnectDelaySeconds": 30
  }
}
