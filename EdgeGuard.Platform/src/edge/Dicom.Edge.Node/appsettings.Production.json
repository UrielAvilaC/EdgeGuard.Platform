{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "NodeDatabase": "Data Source=C:/ProgramData/EdgeGuard/Node/edge-node.db"
  },

  "Diagnostics": {
    "Environment": "Production",

    "File": {
      "Path": "C:/ProgramData/EdgeGuard/Node/logs",
      "FileNameTemplate": "node-.log",
      "MaxFileSizeMb": 200,
      "RetainDays": 90,
      "RetainedFileCountLimit": 90,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false
    },

    "HttpSink": {
      "Enabled": false
    },

    "OpenTelemetry": {
      "Enabled": false
    }
  }
}
