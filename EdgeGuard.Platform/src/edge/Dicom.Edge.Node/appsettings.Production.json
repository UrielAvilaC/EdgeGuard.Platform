{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "NodeDatabase": "Data Source=C:/ProgramData/EdgeGuard/Node/persistence/edge-node.db"
  },

  "Diagnostics": {
    "Environment": "Production",

    "File": {
      "Path": "C:/ProgramData/EdgeGuard/Node/logs",
      "FileNameTemplate": "node-.log",
      "MaxFileSizeMb": 200,
      "RetainDays": 90,
      "RetainedFileCountLimit": 90,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false
    },

    "HttpSink": {
      "Enabled": false
    },

    "OpenTelemetry": {
      "Enabled": false
    },

    "HealthChecks": {
      "StoragePath": "C:/ProgramData/EdgeGuard/Node/data",
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 1000,
      "ConnectivityTimeoutSeconds": 10
    }
  },

  "NodeStorage": {
    "RootPath": "C:/ProgramData/EdgeGuard/Node/data"
  },

  "HubConnection": {
    "Enabled": true,
    "HubBaseUrl": "https://localhost:7228",
    "NodeName": "RIS_SISTEMA",
    "IpAddress": "127.0.0.1",
    "Port": 11112,
    "Location": "RIS SISTEMA",
    "FacilityName": "RIS_SISTEMA",
    "Version": "1.0.0",
    "TimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "ConfigPullIntervalSeconds": 900,
    "RegisterOnStartup": true,
    "MaxReconnectAttempts": 10,
    "ReconnectDelaySeconds": 30
  }
  /*
    BootstrapToken: optional. Si está vacío, el nodo lo solicita automáticamente
    desde POST /edge/token (válido 5 min, de un solo uso).
    Configúralo solo si necesitas un token admin pre-emitido via
    POST /api/nodes/bootstrap-tokens.
  */
}
