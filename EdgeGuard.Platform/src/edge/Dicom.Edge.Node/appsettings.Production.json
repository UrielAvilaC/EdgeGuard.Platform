{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "NodeDatabase": "Data Source=C:/ProgramData/EdgeGuard/Node/data/edge-node.db"
  },

  "Diagnostics": {
    "Environment": "Production",

    "File": {
      "Path": "C:/ProgramData/EdgeGuard/Node/logs",
      "FileNameTemplate": "node-.log",
      "MaxFileSizeMb": 200,
      "RetainDays": 90,
      "RetainedFileCountLimit": 90,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false
    },

    "HttpSink": {
      "Enabled": false
    },

    "OpenTelemetry": {
      "Enabled": false
    },

    "HealthChecks": {
      "StoragePath": "C:/ProgramData/EdgeGuard/Node/data",
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 1000,
      "ConnectivityTimeoutSeconds": 10
    }
  },

  "NodeStorage": {
    "RootPath": "C:/ProgramData/EdgeGuard/Node/data",
    "ArchivePath": "C:/ProgramData/EdgeGuard/Node/workspace"
  },

  "HubConnection": {
    "Enabled": false,
    "HubBaseUrl": "https://<hub-hostname>:443",
    "BootstrapToken": "",
    "NodeName": "",
    "AeTitle": "EDGE_NODE",
    "IpAddress": "127.0.0.1",
    "Port": 11112,
    "ApiEndpoint": "",
    "Location": "",
    "FacilityName": "",
    "Version": "1.0.0",
    "TimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "ConfigPullIntervalSeconds": 900,
    "RegisterOnStartup": true,
    "MaxReconnectAttempts": 10,
    "ReconnectDelaySeconds": 30
  }
  /*
    BootstrapToken: one-time token generated from the Hub UI.
    POST /api/nodes/bootstrap-tokens (admin role required).
    After the node registers successfully the token is invalidated.
  */
}
