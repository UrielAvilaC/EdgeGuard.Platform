{
  // ── Configuración de producción ──────────────────────────────────────────────
  //
  // Este archivo es una PLANTILLA. El instalador (setup\node\install.ps1) lo
  // reescribe completo a partir de node-install.psd1 en cada ejecución.
  //
  // NO LO EDITES A MANO: la siguiente actualización sobreescribirá el cambio.
  // Lo que se edita es el .psd1.
  //
  // Las claves específicas de la sede quedan VACÍAS a propósito. Un valor de
  // relleno aquí enmascararía que el instalador no corrió: el nodo arrancaría
  // mal configurado en lugar de fallar, y el defecto no se manifestaría hasta
  // mucho después. Concretamente, con HubConnection:HubBaseUrl vacío y
  // Enabled = true, HubConnectionOptionsValidator aborta el arranque con un
  // mensaje que nombra la clave — que es justo lo que se quiere.
  //
  // Las rutas de datos sí traen la convención de despliegue como valor, porque
  // no varían entre sedes y porque una cadena de conexión ausente NO falla:
  // caería a 'edge-node.db' relativo al directorio de trabajo, que para un
  // servicio de Windows es C:\Windows\System32.

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Ruta absoluta obligatoria. La base NO puede quedar dentro de la carpeta de
  // estudios: StoragePathGuard lo verifica al arrancar y en Producción se niega
  // a iniciar si se solapan.
  "ConnectionStrings": {
    "NodeDatabase": "Data Source=C:/ProgramData/EdgeGuard/Node/persistence/edge-node.db"
  },

  "Diagnostics": {
    "Environment": "Production",

    // InstanceId identifica al nodo en los registros y en la telemetría. Con
    // varios nodos reportando al mismo destino, repetirlo los vuelve ilegibles,
    // así que el instalador lo reemplaza por el del .psd1. Aquí lleva un valor
    // genérico —y no vacío— porque es obligatorio: dejarlo en blanco haría que
    // el arranque fallara por ESTA clave antes de llegar a HubBaseUrl, y un
    // InstanceId genérico solo ensucia el registro, mientras que una dirección
    // de Hub equivocada deja al nodo incomunicado.
    "InstanceId": "NODE-001",

    "File": {
      "Path": "C:/ProgramData/EdgeGuard/Node/logs",
      "FileNameTemplate": "node-.log",
      "MaxFileSizeMb": 200,
      "RetainDays": 90,
      "RetainedFileCountLimit": 90,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false
    },

    "HttpSink": {
      "Enabled": false
    },

    "OpenTelemetry": {
      "Enabled": false
    },

    // La carpeta que vigila el chequeo de almacenamiento se deriva de la raíz
    // DICOM efectiva (storage.root_path), no se configura aquí.
    "HealthChecks": {
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 1000,
      "ConnectivityTimeoutSeconds": 10
    }
  },

  // ── Claves que el arranque copia a node_settings ───────────────────────────
  //
  // Estas cuatro NO las lee el runtime desde aquí: la fila de la base gana siempre,
  // porque su proveedor de configuración se registra después de appsettings.
  // NodeSettingsDeploymentHydrator las copia a sus filas justo tras migrar — reescribe
  // mientras el nodo no esté registrado, y solo rellena vacíos una vez registrado, para
  // que las ediciones hechas desde el Hub sobrevivan al reinicio.
  //
  // Rellena el instalador. Vacías = el nodo arranca con los valores de fábrica.

  "DicomServer": {
    // El AE title es la identidad del nodo: con él se anuncia al Hub, con él lo llaman
    // las modalidades y con él sale como SCU hacia el PACS. Los tres se derivan de esta
    // única clave, así que escribirla mal los desalinea a la vez. Máximo 16 caracteres,
    // sin espacios; el arranque lo verifica y aborta si no cumple.
    "AeTitle": "",

    // Puerto donde el nodo ESCUCHA C-STORE, C-ECHO y MWL.
    "Port": 11112
  },

  "NodeApi": {
    // Puerto HTTP de la API del nodo: por ahí empuja configuración el Hub y por ahí
    // responde /health/ready.
    "Port": 5120
  },

  "NodeStorage": {
    // Carpeta de los estudios en tránsito. Debe ser un directorio SEPARADO del de la
    // base de datos: si se solapan, la medición del espacio cuenta el archivo SQLite
    // como carga DICOM y la limpieza de emergencia borra estudios para aliviar una
    // presión que no puede aliviar. El arranque lo verifica y se niega a iniciar.
    "RootPath": "C:/ProgramData/EdgeGuard/Node/data"
  },

  "HubConnection": {
    // Enabled es una decisión de infraestructura y NO se mapea desde la base de
    // datos a propósito: el Hub no puede apagar el canal por el que se le habla.
    "Enabled": true,

    // ── Rellena el instalador — vacío aborta el arranque ────────────────────
    "HubBaseUrl": "",

    // ── Rellena el instalador — identidad de esta sede ─────────────────────
    // Estas cuatro se copian a las filas node.* en el primer arranque. En un
    // nodo YA REGISTRADO la base manda y este archivo se ignora: para mover un
    // nodo de Hub hace falta limpiar las filas hub.*, no basta con editar aquí.
    "NodeName": "",
    "FacilityName": "",
    "Location": "",
    "IpAddress": "",

    // Puerto DICOM que el nodo REPORTA al Hub al registrarse. El puerto en el
    // que realmente escucha el SCP sale de la fila dicom.port, que tiene mayor
    // precedencia.
    "Port": 11112,

    // ── Cadencias: no varían entre sedes salvo enlaces lentos ──────────────
    "Version": "",
    "TimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "ConfigPullIntervalSeconds": 900,
    "RegisterOnStartup": true,
    "MaxReconnectAttempts": 10,
    "ReconnectDelaySeconds": 30

    // BootstrapToken: opcional, lo añade el instalador solo si el .psd1 lo trae.
    // Vacío = el nodo pide el suyo al arrancar contra POST /api/edge/token
    // (anónimo, válido 5 minutos, de un solo uso).
  }
}
