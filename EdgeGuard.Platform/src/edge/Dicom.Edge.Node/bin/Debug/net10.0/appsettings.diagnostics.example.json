{
  "Diagnostics": {
    "NodeId": "EDGE-NODE-001",
    "Application": "EdgeNode",
    "Component": "Core",
    "Environment": "Production",
    "CorrelationIdHeader": "X-Request-Id",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "edge-node-.log",
      "MaxFileSizeMb": 100,
      "RetainDays": 30,
      "RetainedFileCountLimit": 31,
      "RollingInterval": "Day",
      "UseCompactJson": true
    },

    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKey": null
    },

    "HttpSink": {
      "Enabled": false,
      "Url": "",
      "BatchPostingLimit": 1000,
      "PeriodSeconds": 5
    },

    "OpenTelemetry": {
      "Enabled": false,
      "OtlpEndpoint": null,
      "ServiceName": "EdgeNode",
      "ServiceVersion": "1.0.0",
      "Prometheus": {
        "Enabled": false,
        "Endpoint": "/metrics"
      }
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Strict",
      "ReplacementToken": "[REDACTED]",
      "RedactedProperties": [
        "PatientName",
        "PatientID",
        "PatientBirthDate",
        "PatientSex",
        "PatientAddress",
        "PatientTelephoneNumbers",
        "OtherPatientIDs",
        "OtherPatientNames",
        "ReferringPhysicianName",
        "InstitutionName",
        "InstitutionAddress"
      ],
      "RedactionPatterns": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "\\b\\d{10,15}\\b"
      ]
    },

    "HealthChecks": {
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 1000,
      "PacsTimeoutSeconds": 10
    }
  },

  "PacsDestination": {
    "Host": "192.168.1.100",
    "Port": 104,
    "AeTitle": "MAIN_PACS"
  }
}
