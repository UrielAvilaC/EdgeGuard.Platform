{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "NodeDatabase": "Data Source=./persistence/edge-node.db"
  },

  "Diagnostics": {
    "InstanceId": "NODE-001",
    "Application": "EdgeGuardNode",
    "Component": "Node",
    "Environment": "Production",
    "MeterName": "Dicom.Edge.Node",
    "ActivitySourceName": "Dicom.Edge.Node",
    "CorrelationIdHeader": "X-Request-Id",

    "File": {
      "Path": "logs",
      "FileNameTemplate": "node-.log",
      "MaxFileSizeMb": 100,
      "RetainDays": 30,
      "RetainedFileCountLimit": 31,
      "RollingInterval": "Day",
      "UseCompactJson": true,

      "PerAssociation": {
        "Enabled": true,
        "Path": "logs/associations",
        "MinimumLevel": "Debug",
        "UseCompactJson": false,
        "RetainDays": 14,
        "MaxFilesPerDay": 5000,
        "MaxFileSizeMb": 10,
        "MaxTotalSizeMb": 2048,
        "MaxOpen": 20,
        "IncludeFoDicomInternals": true,
        "StaleTimeoutMinutes": 20,
        "CleanupIntervalMinutes": 60
      }
    },

    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKey": null
    },

    "HttpSink": {
      "Enabled": false,
      "Url": "",
      "BatchPostingLimit": 1000,
      "PeriodSeconds": 5
    },

    "OpenTelemetry": {
      "Enabled": false,
      "OtlpEndpoint": null,
      "ServiceName": "EdgeGuardNode",
      "ServiceVersion": "1.0.0",
      "Prometheus": {
        "Enabled": false,
        "Endpoint": "/metrics"
      }
    },

    "Redaction": {
      "Enabled": true,
      "Mode": "Strict",
      "ReplacementToken": "[REDACTED]",
      "RedactedProperties": [
        "PatientName",
        "PatientID",
        "PatientBirthDate",
        "PatientSex",
        "PatientAddress",
        "PatientTelephoneNumbers",
        "OtherPatientIDs",
        "OtherPatientNames",
        "ReferringPhysicianName",
        "InstitutionName",
        "InstitutionAddress"
      ],
      "RedactionPatterns": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "\\b\\d{10,15}\\b"
      ]
    },

    "HealthChecks": {
      "StorageMinAvailableMb": 500,
      "QueueMaxPendingItems": 1000,
      "ConnectivityTimeoutSeconds": 10
    }
  },
  "NodeApi": {
    "Port": 5120
  },
  "DicomServer": {
    "Enabled": true,
    "AeTitle": "EDGE_NODE",
    "Port": 11112,
    "MaxClients": 10,
    "CEchoEnabled": true,
    "MwlEnabled": true,
    "ValidateCallingAe": false
  },
  // Este archivo es la BASE: se carga en todos los entornos, antes que el de
  // cada uno. Por eso las claves de sede van VACÍAS aquí.
  //
  // Traían la configuración de una sede concreta (https://localhost:7228,
  // RIS_SISTEMA), y eso convertía un appsettings.Production.json ausente en un
  // nodo que arranca contra el Hub equivocado anunciándose con el nombre de otra
  // sede, en silencio, en vez de negarse a arrancar. El valor vacío es lo que
  // hace que HubConnectionOptionsValidator aborte nombrando la clave.
  //
  // Desarrollo no se ve afectado: appsettings.Development.json trae su propia
  // sección HubConnection completa.
  "HubConnection": {
    "Enabled": true,
    "HubBaseUrl": "",
    "NodeName": "",
    "IpAddress": "",
    "Port": 11112,
    "Location": "",
    "FacilityName": "",
    "Version": "",
    "TimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "ConfigPullIntervalSeconds": 900,
    "RegisterOnStartup": true,
    "MaxReconnectAttempts": 10,
    "ReconnectDelaySeconds": 30
  }
}
